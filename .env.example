# Firebase Web App (Configurações do projeto → Seus apps → Web)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_AUTH_DOMAIN=oitavamusicbetim.firebaseapp.com
FIREBASE_PROJECT_ID=oitavamusicbetim
FIREBASE_STORAGE_BUCKET=oitavamusicbetim.firebasestorage.app

# Firebase Cloud Messaging — chave pública Web Push (VAPID)
FIREBASE_VAPID_KEY=

# E-mails administrativos separados por vírgula
ADMIN_EMAILS=rwsilvatec@gmail.com

# URL fixa usada nos links de convite, notificações e redefinição de senha.
# Ex.: https://seu-dominio.com.br
APP_URL=

# Credencial privada do Firebase Admin (JSON completo da service account)
FIREBASE_ADMIN_SERVICE_ACCOUNT=

# Segredo usado pela rotina agendada de lembretes de escala na Vercel
CRON_SECRET=

# Gmail API — conta usada como remetente dos convites
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=louvordebetim@gmail.com
