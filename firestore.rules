rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isPrimaryAdmin() {
      return signedIn() && request.auth.token.email == 'rwsilvatec@gmail.com';
    }

    function hasAdminDirectoryEntry() {
      return signedIn()
        && exists(/databases/$(database)/documents/accessUsers/$(request.auth.token.email))
        && get(/databases/$(database)/documents/accessUsers/$(request.auth.token.email)).data.role == 'admin';
    }

    function isAdmin() {
      return isPrimaryAdmin() || hasAdminDirectoryEntry();
    }

    // Dados centrais do ministério. O site administrativo ainda acessa
    // estes documentos diretamente; membros devem usar somente o backend.
    match /oitava/{documentId} {
      allow read, write: if isAdmin();
    }

    // Cada usuário precisa conseguir ler somente o próprio vínculo para
    // que o login determine seu papel. Administradores gerenciam o diretório.
    match /accessUsers/{email} {
      allow get: if signedIn() && email == request.auth.token.email;
      allow read, write: if isAdmin();
    }

    // Um convidado autenticado pode criar/consultar/atualizar apenas o seu
    // próprio cadastro. Administradores podem revisar e concluir cadastros.
    match /memberRegistrations/{uid} {
      allow create, get, update: if signedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Tudo que não estiver explicitamente previsto acima fica bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
